doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    link(rel="stylesheet", href="/css/homepage.css")
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap", rel="stylesheet")
    title Pet Directory

  body
    .bg-orb.orb-1
    .bg-orb.orb-2
    .bg-orb.orb-3

    .page
      h1.title Registered Pets
      a(href="http://localhost:3001/add-pet").title Add/Update this table
      .table-wrap
        table.pet-table
          thead
            tr
              th(scope="col") Photo
              th(scope="col") Name
              th(scope="col") Type
              th(scope="col") Age
              th(scope="col") Vaccine Center
          tbody
            if pets.length
              each pet in pets
                tr
                  td.photo-cell
                    if pet.properties.pet_image
                      img.pet-img(src=pet.properties.pet_image alt=`Image of ${pet.properties.pet_name || 'pet'}`)
                    else
                      span.no-image No image
                  td= pet.properties.pet_name || 'Unnamed Pet'
                  td= pet.properties.pet_type || 'N/A'
                  td= pet.properties.pet_age || 'N/A'
                  td= pet.properties.vaccine_center || 'N/A'
            else
              tr
                td.empty-state(colspan="5") No registered pets found.
