doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    link(rel="stylesheet", href="/css/homepage.css")
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap", rel="stylesheet")
    title Add Pet

  body
    .bg-orb.orb-1
    .bg-orb.orb-2
    .bg-orb.orb-3

    .page
      .page-header
        span.eyebrow Pet Directory
        h1.title Register a New Pet
        p.subtitle Fill in the details below to add a new companion to the directory.

      .form-card
        .card-glow
        form(action="/add-pet" method="POST" enctype="multipart/form-data")

          .field
            label(for="pet_name")
              span.field-icon 🐾
              | Pet Name
            input(type="text" id="pet_name" name="pet_name" placeholder="e.g. Bella" required)

          .field
            label(for="pet_type")
              span.field-icon 🐶
              | Pet Type
            input(type="text" id="pet_type" name="pet_type" placeholder="e.g. Labrador" required)

          .field
            label(for="pet_age")
              span.field-icon 🎂
              | Pet Age
            input(type="number" id="pet_age" name="pet_age" placeholder="e.g. 2" min="0" required)

          .field
            label(for="vaccine_center")
              span.field-icon 💉
              | Vaccine Center
            input(type="text" id="vaccine_center" name="vaccine_center" placeholder="e.g. Downtown Vet Clinic" required)

          .field
            label(for="pet_image")
              span.field-icon 📷
              | Pet Image

            .file-upload
              input(type="file" id="pet_image" name="pet_image" accept="image/*")
              label.file-upload-label(for="pet_image")
                span.file-upload-icon ⬆
                span.file-upload-text Choose a photo or drag it here
                span.file-upload-name(data-default="Choose a photo or drag it here")

          button.submit-btn(type="submit")
            span Register Pet
            span.btn-arrow →

      a.back-link(href="/")
        span.back-arrow ←
        |  Back to Pet Directory

    script.
      const fileInput = document.getElementById('pet_image');
      const fileNameEl = document.querySelector('.file-upload-name');
      fileInput.addEventListener('change', () => {
        const file = fileInput.files[0];
        fileNameEl.textContent = file ? file.name : fileNameEl.dataset.default;
        fileNameEl.closest('.file-upload-label').classList.toggle('has-file', !!file);
      });